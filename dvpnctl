    assert best_node(cfg, nodes, exclude={"sentnode1cheap"})["address"] == "sentnode1cheap", \
        "single-node fallback ignores exclusion only when nothing else remains"
    assert max_price_str(n) == "udvpn:0.0025,12500000", max_price_str(n)

    # node-id extraction from a tx event payload
    tx = ('{"result":{"tx_result":{"log":"[{\\"events\\":[{\\"type\\":'
          '\\"sentinel.session.v3.EventCreateSession\\",\\"attributes\\":'
          '[{\\"key\\":\\"session_id\\",\\"value\\":\\"61151809\\"}]}]}]"}}}')
    assert tx_session_id(tx) == 61151809, tx_session_id(tx)
    assert tx_session_id("garbage") is None
    print("selftest OK")


# ---------------------------------------------------------------- entrypoint

def main():
    have_yaml()
    ap = argparse.ArgumentParser(prog="dvpnctl", description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("init", help="create the wallet (once)").set_defaults(fn=cmd_init)
    sub.add_parser("address", help="print wallet address").set_defaults(fn=cmd_address)
    sub.add_parser("balance", help="print DVPN balance").set_defaults(fn=cmd_balance)
    sub.add_parser("fund", help="show where to send DVPN").set_defaults(fn=cmd_fund)
    sub.add_parser("selftest", help="run offline self-check").set_defaults(fn=cmd_selftest)

    pn = sub.add_parser("nodes", help="list usable wireguard nodes")
    pn.add_argument("-r", "--refresh", action="store_true", help="ignore cache")
    pn.add_argument("-c", "--country", help="filter by 2-letter country code")
    pn.add_argument("-a", "--all", action="store_true", help="ignore price cap")
    pn.set_defaults(fn=cmd_nodes)

    sub.add_parser("best", help="print the auto-selected node").set_defaults(fn=cmd_best)

    def add_session_flags(p):
        p.add_argument("-g", "--gigabytes", type=int)
        p.add_argument("-H", "--hours", type=int)

    pu = sub.add_parser("up", help="start session + full-tunnel connection")
    pu.add_argument("node", nargs="?", help="#, moniker, address, or best")
    add_session_flags(pu)
    pu.set_defaults(fn=cmd_up)

    pd = sub.add_parser("down", help="disconnect + remove kill switch")
    pd.add_argument("--keep-session", action="store_true",
                    help="do not cancel the on-chain session")
    pd.set_defaults(fn=cmd_down)

    ps = sub.add_parser("switch", help="switch endpoint")
    ps.add_argument("node", nargs="?")
    add_session_flags(ps)
    ps.set_defaults(fn=cmd_switch)

    sub.add_parser("status", help="show connection + balance").set_defaults(fn=cmd_status)
    sub.add_parser("verify", help="prove traffic is tunneled (routing/firewall/exit IP)"
                   ).set_defaults(fn=cmd_verify)
    sub.add_parser("watch", help="health probe + auto-failover (run from a timer)"
                   ).set_defaults(fn=cmd_watch)

    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
