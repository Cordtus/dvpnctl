# ---------------------------------------------------------------- helpers

def cli_path() -> str:
    for p in ("/usr/local/bin/sentinel-dvpncli",
              os.path.join(HOME, ".local", "bin", "sentinel-dvpncli")):
        if os.path.exists(p):
            return p
    found = shutil.which("sentinel-dvpncli")
    if not found:
        sys.exit("sentinel-dvpncli not found; run ./install.sh")
    return found


def load_cfg() -> dict:
    cfg = dict(DEFAULTS)
    if os.path.exists(CFG_FILE):
        with open(CFG_FILE) as f:
            cfg.update(json.load(f))
    return cfg


def save_cfg(cfg: dict) -> None:
    os.makedirs(CFG_DIR, mode=0o700, exist_ok=True)
    with open(CFG_FILE, "w") as f:
        json.dump(cfg, f, indent=2, sort_keys=True)


def unit_name() -> str:
    return load_cfg()["unit_name"]


def iface() -> str:
    return load_cfg()["iface"]


def cli_home() -> str:
    return load_cfg()["cli_home"]


def excluded_nodes() -> dict[str, float]:
    """Nodes the watchdog is temporarily avoiding: {address: expiry_unix}."""
    if not os.path.exists(EXCLUDED_FILE):
        return {}
    try:
        data = json.load(open(EXCLUDED_FILE))
    except Exception:
        return {}
    now = time.time()
    return {k: v for k, v in data.items() if isinstance(v, (int, float)) and v > now}


def exclude_node(addr: str, ttl: int) -> None:
    data = excluded_nodes()
    data[addr] = time.time() + ttl
    os.makedirs(CFG_DIR, mode=0o700, exist_ok=True)
    with open(EXCLUDED_FILE, "w") as f:
        json.dump(data, f, indent=2)


def clear_exclusions() -> None:
    if os.path.exists(EXCLUDED_FILE):
        os.remove(EXCLUDED_FILE)


def external_ip(timeout: int = 8) -> str | None:
    """Return this host's public IP as seen from the current routing."""
    try:
        req = Request("https://api.ipify.org", headers={"User-Agent": "dvpnctl"})
        with urlopen(req, timeout=timeout) as r:
            return r.read().decode().strip()
    except Exception:
        return None


def speed_cache() -> dict[str, dict]:
    if not os.path.exists(SPEED_FILE):
        return {}
    try:
        return json.load(open(SPEED_FILE))
    except Exception:
        return {}


def cached_speed(addr: str, ttl: int) -> float | None:
    e = speed_cache().get(addr)
    if not e or time.time() - e.get("ts", 0) > ttl:
        return None
    return e.get("bps")


def record_speed(addr: str, bps: float) -> None:
    data = speed_cache()
    data[addr] = {"bps": bps, "ts": time.time()}
    os.makedirs(CFG_DIR, mode=0o700, exist_ok=True)
    with open(SPEED_FILE, "w") as f:
        json.dump(data, f, indent=2)


def measure_speed(cfg: dict) -> float | None:
    """Download a known-size payload through the current tunnel; return bytes/sec.

    Measures the real end-to-end path (the tunnel), not the node's API. Returns
    None on failure/timeout. `TimeoutError` mid-download still yields an estimate
    if some bytes arrived, which is useful for very slow nodes.
    """
    url = cfg["speed_test_url"]
    timeout = cfg["speed_test_timeout"]
    req = Request(url, headers={"User-Agent": "dvpnctl"})
    start = time.time()
    total = 0
    try:
        with urlopen(req, timeout=timeout) as r:
            while True:
                chunk = r.read(65536)
                if not chunk:
                    break
                total += len(chunk)
                if time.time() - start > timeout:
                    break
    except Exception:
        if total == 0:
            return None
    elapsed = time.time() - start
    if elapsed <= 0 or total == 0:
        return None
    return total / elapsed


# The CLI emits a harmless sonic/ast fallback warning on stderr before real
# errors; drop it so it does not bury the actual message.
SONIC_NOISE = "sonic/ast only supports"


def clean_stderr(text: str) -> str:
    return "".join(l for l in text.splitlines(keepends=True) if SONIC_NOISE not in l)


def run(cmd: list[str], check: bool = True, stdin: str | None = None) -> subprocess.CompletedProcess:
    p = subprocess.run(cmd, input=stdin, capture_output=True, text=True)
    if check and p.returncode != 0:
        sys.stderr.write((p.stdout or "") + clean_stderr(p.stderr or ""))
        sys.exit(p.returncode)
    return p


def cli(args: list[str], check: bool = True, stdin: str | None = None,
        rpc: bool = False) -> str:
    # The binary emits a harmless sonic warning on stderr; stdout is clean.
    base = [cli_path(), "--home", cli_home(), "--log.level", "error"]
    if not rpc:
        return run([*base, *args], check=check, stdin=stdin).stdout
    # Query only: retry across RPC endpoints on failure/rate-limit.
    cfg = load_cfg()
    endpoints = [cfg["rpc"]] + [u for u in RPC_FALLBACKS if u != cfg["rpc"]]
    p = None
    for url in endpoints:
        p = run([*base, *args, "--rpc.addrs", url, "--rpc.timeout", "15s"],
                check=False, stdin=stdin)
        if p.returncode == 0:
            return p.stdout
    if check and p is not None:
        sys.stderr.write((p.stdout or "") + clean_stderr(p.stderr or ""))
        sys.exit(p.returncode)
    return p.stdout if p is not None else ""


def tx_with_retry(args: list[str], verify) -> str:
    """Run a tx, retrying across RPC endpoints.

    verify() must return truthy if the tx already took effect. It is checked
    after a failed broadcast so a response timeout cannot cause a double-submit.
    """
    cfg = load_cfg()
    endpoints = [cfg["rpc"]] + [u for u in RPC_FALLBACKS if u != cfg["rpc"]]
    last = None
    for url in endpoints:
        p = run([cli_path(), "--home", cli_home(), "--log.level", "error", "tx", *args,
                 "--keyring.backend", cfg["keyring_backend"],
                 "--tx.from-name", cfg["key_name"],
                 "--output-format", "json",
                 "--rpc.addrs", url, "--rpc.timeout", "15s"], check=False)
        if p.returncode == 0:
            return p.stdout
        last = p
        sys.stderr.write((p.stdout or "") + clean_stderr(p.stderr or ""))
        time.sleep(3)
        if verify():
            print("transaction landed despite the RPC error; continuing")
            return ""
    sys.stderr.write((last.stdout or "") + clean_stderr(last.stderr or "") if last else "")
    sys.exit("transaction failed on all RPC endpoints")


def cli_keys(args: list[str], stdin: str | None = None) -> str:
    cfg = load_cfg()
    return cli(["keys", *args, "--keyring.backend", cfg["keyring_backend"]],
               check=True, stdin=stdin)


def extract_json(text: str):
    """Pull a JSON value out of CLI output that may also contain banners."""
    for line in reversed(text.splitlines()):
        line = line.strip()
        if not line:
            continue
        try:
            return json.loads(line)
        except json.JSONDecodeError:
            continue
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        return None


def walk(obj):
    """Yield every dict nested anywhere inside obj."""
    if isinstance(obj, dict):
        yield obj
        for v in obj.values():
            yield from walk(v)
    elif isinstance(obj, list):
        for v in obj:
            yield from walk(v)


