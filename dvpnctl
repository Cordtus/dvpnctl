def cmd_verify(args):
    """Prove that traffic is actually tunneled: routing, firewall, and exit IP."""
    cfg = load_cfg()
    up = unit_active() and _iface_up()
    ok = True

    print(f"interface : {iface()} {'up' if _iface_up() else 'DOWN'}")
    if not _iface_up():
        ok = False

    # ip rules: wg-quick default-route mode adds a `not fwmark` rule + suppress
    rules = subprocess.run(["ip", "rule"], capture_output=True, text=True).stdout
    has_rule = "suppress_prefixlength 0" in rules
    print(f"ip rules  : {'default-route rules present' if has_rule else 'MISSING'}")
    ok &= has_rule

    # firewall: the SDK's fail-closed OUTPUT DROP must exist for the interface
    for tool in ("iptables", "ip6tables"):
        out = subprocess.run(["sudo", "-n", tool, "-S", "OUTPUT"],
                             capture_output=True, text=True)
        text = out.stdout if out.returncode == 0 else ""
        drop = any(iface() in l and "DROP" in l for l in text.splitlines())
        print(f"{tool:<9} : {'kill-switch DROP present' if drop else 'not readable/MISSING'}")
        if not text:
            # can't inspect without sudo; don't fail the check, just note it
            continue
        ok &= drop

    # exit IP: with the tunnel up it must differ from the direct path
    direct = external_ip(cfg["watch_timeout"])
    print(f"exit IP   : {direct or 'unreachable'}")
    if up and direct is None:
        ok = False

    if up:
        gw = subprocess.run(["wg", "show", iface(), "endpoints"],
                            capture_output=True, text=True).stdout.strip()
        print(f"peer      : {gw or '-'}")
    print("RESULT    : " + ("tunneled (all host traffic exits the node, or is dropped)"
                            if ok else "NOT fully verified"))
    sys.exit(0 if ok else 1)


def _iface_up() -> bool:
    p = subprocess.run(["wg", "show", iface()], capture_output=True, text=True)
    return p.returncode == 0 and bool(p.stdout.strip())


def cmd_watch(args):
    """Health probe; fail over to another node after repeated failures.

    Designed to run from a systemd timer. Exits 0 when healthy (or when no
    tunnel is up), non-zero only on an unexpected internal error.
    """
    cfg = load_cfg()
    if not _iface_up():
        print("watch: tunnel down, nothing to do")
        return
    fails_file = os.path.join(CFG_DIR, "watch.fails")
    fails = int(open(fails_file).read().strip() or 0) if os.path.exists(fails_file) else 0

    probe = external_ip(cfg["watch_timeout"])
    if probe:
        if fails:
            print("watch: recovered")
        if os.path.exists(fails_file):
            os.remove(fails_file)
        return

    fails += 1
    print(f"watch: probe failed ({fails}/{cfg['watch_fail_threshold']})")
    os.makedirs(CFG_DIR, mode=0o700, exist_ok=True)
    with open(fails_file, "w") as f:
        f.write(str(fails))
    if fails < cfg["watch_fail_threshold"]:
        return

    cur = cfg.get("node")
    if cur:
        exclude_node(cur, cfg["watch_exclude_ttl"])
        print(f"watch: excluding {cur} for {cfg['watch_exclude_ttl']}s")

    # tear down the bad tunnel, then bring up the best non-excluded node
    subprocess.run(["sudo", "-n", "systemctl", "stop", unit_name()],
                   capture_output=True)
    if os.path.exists(fails_file):
        os.remove(fails_file)
    nodes = fetch_nodes(refresh=True)
    exc = set(excluded_nodes())
    if not nodes:
        print("watch: no nodes available to fail over to", file=sys.stderr)
        sys.exit(1)
    node = best_node(cfg, nodes, exclude=exc)
    if node["address"] in exc:
        print("watch: every node is excluded; clearing exclusions")
        clear_exclusions()
        node = best_node(cfg, nodes)
    print(f"watch: failing over to {node['moniker']} [{node['country']}]")
    cmd_up(argparse.Namespace(node=node["address"], gigabytes=None, hours=None))


