# ---------------------------------------------------------------- wallet

def my_address() -> str | None:
    out = cli_keys(["list", "--output-format", "json"])
    data = extract_json(out)
    if not data:
        return None
    items = data if isinstance(data, list) else [data]
    name = load_cfg()["key_name"]
    for k in items:
        if isinstance(k, dict) and k.get("name") == name:
            return k.get("address")
    return None


def wallet_exists() -> bool:
    return my_address() is not None


def derive_address(mnemonic: str) -> str | None:
    """Address for a mnemonic, derived in a throwaway in-memory keyring."""
    tmp = tempfile.mkdtemp(prefix="dvpnctl-keycheck-")
    try:
        out = cli(["--home", tmp, "--keyring.backend", "memory",
                   "keys", "add", "probe", "--output-format", "json"],
                  check=False, stdin=f"{mnemonic}\n\n")
        data = extract_json(out)
        return data.get("address") if isinstance(data, dict) else None
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def recover_backup() -> None:
    """Recreate wallet-backup.json from the mnemonic when it was moved away.

    install.sh needs this file to seed the root service keyring, but `init`
    would otherwise refuse because the wallet already exists.
    """
    addr = my_address()
    print(f"wallet {addr} exists but its mnemonic backup is missing:")
    print(f"  {WALLET_BACKUP}")
    print("Enter the wallet mnemonic to recreate it (hidden; Ctrl-C aborts).")
    mnemonic = getpass.getpass("mnemonic: ").strip()
    if not mnemonic:
        sys.exit("no mnemonic entered; nothing written")
    if derive_address(mnemonic) != addr:
        sys.exit("that mnemonic does not match this wallet's address; nothing written")
    os.makedirs(CFG_DIR, mode=0o700, exist_ok=True)
    with open(WALLET_BACKUP, "w") as f:
        json.dump({"name": load_cfg()["key_name"], "address": addr, "mnemonic": mnemonic}, f, indent=2)
    os.chmod(WALLET_BACKUP, 0o600)
    print(f"backup written to {WALLET_BACKUP} (mode 600).")
    print("Now re-run:  sudo ./install.sh <user>  to seed the root service keyring.")


def cmd_init(args):
    if wallet_exists():
        if os.path.exists(WALLET_BACKUP):
            print(f"wallet already exists: {my_address()}")
            return
        recover_backup()
        return
    # keys add prompts for a mnemonic then a bip39 passphrase; blank lines accept defaults.
    out = cli_keys(["add", load_cfg()["key_name"], "--output-format", "json"],
                   stdin="\n\n")
    data = extract_json(out)
    if not data or "address" not in data:
        sys.stderr.write(out)
        sys.exit("could not parse generated key")
    os.makedirs(CFG_DIR, mode=0o700, exist_ok=True)
    with open(WALLET_BACKUP, "w") as f:
        json.dump(data, f, indent=2)
    os.chmod(WALLET_BACKUP, 0o600)
    print(f"address: {data['address']}")
    print(f"mnemonic backup written to {WALLET_BACKUP} (mode 600)")
    print("Move that file somewhere safe; it is the only way to recover funds.")


def cmd_address(args):
    addr = my_address()
    print(addr if addr else "no wallet yet - run: dvpnctl init")
    if not addr:
        sys.exit(1)


# ---------------------------------------------------------------- chain

def balance_dvpn() -> float | None:
    addr = my_address()
    if not addr:
        return None
    for base in LCD_ENDPOINTS:
        try:
            req = Request(f"{base}/cosmos/bank/v1beta1/balances/{addr}",
                          headers={"User-Agent": "dvpnctl"})
            with urlopen(req, timeout=10) as r:
                data = json.load(r)
            for c in data.get("balances", []):
                if c.get("denom") == "udvpn":
                    return int(c["amount"]) / 1e6
            return 0.0
        except Exception:
            continue
    return None


# ---------------------------------------------------------------- nodes

def normalize_nodes(raw: str) -> list[dict]:
    import yaml
    data = yaml.safe_load(raw) or {}
    nodes = []
    for it in data.get("items") or []:
        if not isinstance(it, dict):
            continue
        info = it.get("info") or {}
        node = it.get("node") or {}
        if info.get("service_type") != "wireguard":
            continue  # v2ray/xray are SOCKS proxies: not a full tunnel
        gp = {p["denom"]: p for p in (node.get("gigabyte_prices") or []) if "denom" in p}
        hp = {p["denom"]: p for p in (node.get("hourly_prices") or []) if "denom" in p}
        loc = info.get("location") or {}
        entry = {
            "address": node.get("address") or info.get("addr"),
            "moniker": info.get("moniker") or "?",
            "service_type": info.get("service_type"),
            "country": loc.get("country_code") or "??",
            "city": loc.get("city") or "",
            "downlink": int(info.get("downlink") or 0),
            "uplink": int(info.get("uplink") or 0),
            "peers": int(info.get("peers") or 0),
            "gb": None,
            "hour": None,
        }
        if "udvpn" in gp:
            entry["gb"] = {"base": gp["udvpn"]["base_value"],
                           "quote": int(gp["udvpn"]["quote_value"])}
        if "udvpn" in hp:
            entry["hour"] = {"base": hp["udvpn"]["base_value"],
                             "quote": int(hp["udvpn"]["quote_value"])}
        if entry["gb"] or entry["hour"]:
            nodes.append(entry)
    return nodes


def fetch_nodes(limit: int = 400, refresh: bool = False) -> list[dict]:
    if not refresh and os.path.exists(NODES_CACHE):
        age = time.time() - os.path.getmtime(NODES_CACHE)
        if age < NODES_CACHE_TTL:
            with open(NODES_CACHE) as f:
                return normalize_nodes(f.read())
    out = cli(["query", "nodes", "--status", "active",
               "--page.limit", str(limit), "--page.count-total"], rpc=True)
    os.makedirs(CFG_DIR, exist_ok=True)
    with open(NODES_CACHE, "w") as f:
        f.write(out)
    return normalize_nodes(out)


def sort_nodes(nodes: list[dict]) -> list[dict]:
    # cheapest usable nodes first, then fastest
    def key(n):
        price = (n["gb"] or n["hour"])["quote"]
        return (price, -n["downlink"])
    return sorted(nodes, key=key)


def gb_price(node: dict) -> float | None:
    return node["gb"]["quote"] / 1e6 if node.get("gb") else None


def max_price_str(node: dict) -> str:
    p = node["gb"] or node["hour"]
    return f"udvpn:{p['base']},{p['quote']}"


def best_node(cfg: dict, nodes: list[dict], exclude: set[str] | None = None) -> dict:
    exclude = exclude or set()
    pool = [n for n in nodes
            if n["address"] not in exclude
            and n.get("gb") and gb_price(n) <= cfg["max_price_per_gb"]
            and n["peers"] <= cfg["max_peers"]]
    if not pool:
        pool = [n for n in nodes if n["address"] not in exclude and n.get("gb")]
    if not pool:
        pool = [n for n in nodes if n["address"] not in exclude] or nodes
    return max(pool, key=lambda n: n["downlink"])


def fetch_one(addr: str) -> dict | None:
    out = cli(["query", "node", addr], rpc=True)
    # query node returns {info, node}; reuse the list normalizer
    import yaml
    data = yaml.safe_load(out) or {}
    wrapped = {"items": [data]}
    nodes = normalize_nodes(yaml.safe_dump(wrapped))
    return nodes[0] if nodes else None


def resolve_node(cfg: dict, spec: str, nodes: list[dict]) -> dict:
    if not spec or spec in ("best", "auto"):
        return best_node(cfg, nodes)
    if spec.startswith("sentnode"):
        for n in nodes:
            if n["address"] == spec:
                return n
        one = fetch_one(spec)
        if not one:
            sys.exit(f"node {spec} is not an active wireguard node with udvpn pricing")
        return one
    if spec.isdigit():
        idx = int(spec)
        order = []
        if os.path.exists(NODES_ORDER):
            order = [l.strip() for l in open(NODES_ORDER) if l.strip()]
        if not order:
            cfg = load_cfg()
            order = [n["address"] for n in sort_nodes(nodes)
                     if n.get("gb") and gb_price(n) <= cfg["max_price_per_gb"]]
        if not (1 <= idx <= len(order)):
            sys.exit(f"index {idx} out of range (1..{len(order)}) - run `dvpnctl nodes`")
        addr = order[idx - 1]
        for n in nodes:
            if n["address"] == addr:
                return n
        one = fetch_one(addr)
        if not one:
            sys.exit(f"node #{idx} ({addr}) is no longer available")
        return one
    matches = [n for n in nodes if spec.lower() in n["moniker"].lower()]
    if not matches:
        sys.exit(f"no node matches {spec!r}")
    if len(matches) > 1:
        print("ambiguous; matches:")
        for m in matches[:10]:
            print(f"  {m['moniker']} {m['address']} {m['country']}")
        sys.exit(1)
    return matches[0]


def cmd_nodes(args):
    cfg = load_cfg()
    nodes = sort_nodes(fetch_nodes(refresh=args.refresh))
    if args.country:
        nodes = [n for n in nodes if n["country"].upper() == args.country.upper()]
    if not args.all:
        nodes = [n for n in nodes if gb_price(n) is not None
                 and gb_price(n) <= cfg["max_price_per_gb"]]
    os.makedirs(CFG_DIR, mode=0o700, exist_ok=True)
    with open(NODES_ORDER, "w") as f:
        f.write("\n".join(n["address"] for n in nodes) + "\n")
    print(f"{'#':>3} {'DVPN/GB':>9} {'down MB/s':>9} {'peers':>5} {'CC':>3}  moniker (address)")
    for i, n in enumerate(nodes, 1):
        p = gb_price(n)
        print(f"{i:>3} {p if p is not None else float('nan'):>9.3f} "
              f"{n['downlink']/1e6:>9.2f} {n['peers']:>5} {n['country']:>3}  "
              f"{n['moniker']} ({n['address']})")
    print(f"\n{len(nodes)} nodes. Connect with: dvpnctl up <#>|best")


def cmd_best(args):
    cfg = load_cfg()
    nodes = fetch_nodes()
    n = best_node(cfg, nodes)
    print(json.dumps(n, indent=2))


# ---------------------------------------------------------------- sessions

def find_active_session(addr: str, node: str, timeout: float = 20.0) -> int | None:
    """Newest active session for a node. Queries every RPC and takes the max so a
    lagging node cannot hide a session that another node already has."""
    import yaml
    cfg = load_cfg()
    endpoints = [cfg["rpc"]] + [u for u in RPC_FALLBACKS if u != cfg["rpc"]]
    deadline = time.time() + timeout
    while True:
        best = None
        for url in endpoints:
            p = run([cli_path(), "--home", cli_home(), "--log.level", "error",
                     "query", "sessions", "--account-addr", addr, "--page.limit", "100",
                     "--rpc.addrs", url, "--rpc.timeout", "15s"], check=False)
            if p.returncode != 0:
                continue
            data = yaml.safe_load(p.stdout) or {}
            for d in walk(data):
                sid = d.get("id")
                if (d.get("node_address") == node and session_active(d.get("status"))
                        and isinstance(sid, (int, float))):
                    # the YAML emitter may render uint64 ids as 6.1139744e+07
                    sid = int(sid)
                    if best is None or sid > best:
                        best = sid
        if best is not None:
            return best
        if time.time() >= deadline:
            return None
        time.sleep(3)


def tx_session_id(text: str) -> int | None:
    """Pull the session id from a tx's own events (authoritative, no stale read).

    The events live inside `tx_result.log`, which is itself a JSON-encoded
    string, so walk both the outer object and any JSON strings found within.
    """
    data = extract_json(text)
    if not data:
        return None
    ids = []
    for blob in _json_strings(data):
        for d in walk(blob):
            if d.get("key") == "session_id":
                v = str(d.get("value", "")).strip('"')
                if v.isdigit():
                    ids.append(int(v))
    return max(ids) if ids else None


def _json_strings(obj):
    """Yield obj plus any embedded JSON string values (one level of nesting)."""
    yield obj
    if isinstance(obj, dict):
        for v in obj.values():
            yield from _json_strings(v)
    elif isinstance(obj, list):
        for v in obj:
            yield from _json_strings(v)
    elif isinstance(obj, str):
        s = obj.strip()
        if s[:1] in "[{":
            try:
                yield json.loads(s)
            except json.JSONDecodeError:
                pass


def start_session(cfg: dict, node: dict, reconcile: bool = True) -> int:
    addr = my_address()
    if reconcile:
        # tidy stale/duplicate sessions and reuse a good one if it exists
        kept = reconcile_sessions({node["address"]: -1})
        if node["address"] in kept:
            sid = kept[node["address"]]
            print(f"reusing active session {sid} on {node['moniker']}")
            return sid
    existing = find_active_session(addr, node["address"], timeout=0)
    if existing is not None:
        print(f"reusing active session {existing} on {node['moniker']}")
        return existing
    if cfg["session_gigabytes"] > 0:
        price = node["gb"]
        if not price:
            sys.exit(f"{node['moniker']} has no udvpn gigabyte price; pick another node")
        mode = ["--gigabytes", str(cfg["session_gigabytes"])]
        deposit = price["quote"] * cfg["session_gigabytes"] / 1e6
    else:
        price = node["hour"]
        if not price:
            sys.exit(f"{node['moniker']} has no udvpn hourly price; pick another node")
        mode = ["--hours", str(cfg["session_hours"])]
        deposit = price["quote"] * cfg["session_hours"] / 1e6

    bal = balance_dvpn()
    need = deposit + 0.1
    if bal is not None and bal < need:
        print(f"insufficient balance: have {bal:.4f} DVPN, need ~{need:.4f} DVPN "
              f"for a {cfg['session_gigabytes'] or cfg['session_hours']} "
              f"{'GB' if cfg['session_gigabytes'] else 'h'} session")
        print(f"fund: {addr}")
        sys.exit(2)

    max_price = max_price_str(node)
    print(f"starting session on {node['moniker']} ({node['address']}) "
          f"deposit ~{deposit:.4f} DVPN ...")
    out = tx_with_retry(["session-start", node["address"], *mode, "--max-price", max_price],
                        lambda: find_active_session(addr, node["address"], timeout=0) is not None)

    # Prefer the id in the tx's own events; fall back to an on-chain lookup.
    sid = tx_session_id(out) or find_active_session(addr, node["address"])
    if sid is None:
        sys.exit("session start broadcast, but no active session was found")
    cfg["node"] = node["address"]
    cfg["node_moniker"] = node["moniker"]
    save_cfg(cfg)
    return sid


def session_status(sid: int):
    import yaml
    raw = cli(["query", "session", str(sid)], rpc=True)
    data = yaml.safe_load(raw) or {}
    for d in walk(data):
        v = d.get("id")
        if isinstance(v, (int, float)) and int(v) == sid and "status" in d:
            return d.get("status")
    return None


def session_active(v) -> bool:
    return v in (1, "1", "active", "STATUS_ACTIVE")


def cancel_session(sid: int, wait: bool = False) -> None:
    # A cancelled session lingers as inactive_pending for a block or two, and
    # cancelling it again is rejected with an "invalid status" error. Skip the
    # tx when it is already inactive (or gone).
    if not session_active(session_status(sid)):
        return
    tx_with_retry(["session-cancel", str(sid)],
                  lambda: not session_active(session_status(sid)))
    if wait:
        # cancel only marks inactive_pending; the chain deletes it a block or
        # two later. Wait until it is gone so a new session gets a new id.
        deadline = time.time() + 60
        while time.time() < deadline:
            if session_status(sid) is None:
                return
            time.sleep(3)
        sys.exit(f"session {sid} did not clear after cancel; try again shortly")


def session_on(url: str, sid: int) -> bool:
    import yaml
    p = run([cli_path(), "--home", cli_home(), "--log.level", "error",
             "query", "session", str(sid),
             "--rpc.addrs", url, "--rpc.timeout", "15s"], check=False)
    if p.returncode != 0:
        return False
    data = yaml.safe_load(p.stdout) or {}
    for d in walk(data):
        v = d.get("id")
        if isinstance(v, (int, float)) and int(v) == sid and session_active(d.get("status")):
            return True
    return False


def working_rpc(sid: int) -> str:
    """First endpoint that actually reports this session active (RPC nodes lag)."""
    cfg = load_cfg()
    endpoints = [cfg["rpc"]] + [u for u in RPC_FALLBACKS if u != cfg["rpc"]]
    for url in endpoints:
        if session_on(url, sid):
            return url
    return cfg["rpc"]


def write_session_file(sid: int) -> None:
    """Write the values the systemd unit needs to run `connect`."""
    cfg = load_cfg()
    os.makedirs(CFG_DIR, mode=0o700, exist_ok=True)
    with open(SESSION_FILE, "w") as f:
        f.write(f"DVPNCTL_SESSION_ID={sid}\n")
        f.write(f"DVPNCTL_RPC={working_rpc(sid)}\n")
        f.write(f"DVPNCTL_CLI={cli_path()}\n")
        f.write(f"DVPNCTL_ROOT_HOME={cfg['root_home']}\n")
        f.write(f"DVPNCTL_IFACE={cfg['iface']}\n")
        if cfg["exclude_lan"]:
            # The engine already excludes loopback + RFC1918 by default.
            f.write("DVPNCTL_EXCLUDE=\n")
        else:
            # stringArray flag: one prefix per occurrence (no comma joining), and
            # the unit word-splits $DVPNCTL_EXCLUDE into separate args.
            f.write("DVPNCTL_EXCLUDE=--wireguard.exclude-addrs=127.0.0.0/8 "
                    "--wireguard.exclude-addrs=::1/128\n")


def read_session_file() -> int | None:
    if not os.path.exists(SESSION_FILE):
        return None
    for line in open(SESSION_FILE):
        m = re.match(r"\s*DVPNCTL_SESSION_ID=(\d+)", line)
        if m:
            return int(m.group(1))
    return None


def all_sessions() -> list[dict]:
    """Every session on the account, keyed by id, with the freshest view across
    all RPCs (they disagree while the chain catches up)."""
    import yaml
    cfg = load_cfg()
    endpoints = [cfg["rpc"]] + [u for u in RPC_FALLBACKS if u != cfg["rpc"]]
    by_id: dict[int, dict] = {}
    for url in endpoints:
        p = run([cli_path(), "--home", cli_home(), "--log.level", "error",
                 "query", "sessions", "--account-addr", my_address(),
                 "--page.limit", "200", "--rpc.addrs", url, "--rpc.timeout", "15s"],
                check=False)
        if p.returncode != 0:
            continue
        for d in walk(yaml.safe_load(p.stdout) or {}):
            sid = d.get("id")
            if not isinstance(sid, (int, float)):
                continue
            sid = int(sid)
            # a later endpoint reporting a different status may be stale; keep
            # the highest status value (active=1 < pending=2 < inactive=3)
            prev = by_id.get(sid)
            if prev is None or status_rank(d.get("status")) > status_rank(prev.get("status")):
                by_id[sid] = {**d, "id": sid}
    return list(by_id.values())


def status_rank(v) -> int:
    if session_active(v):
        return 1
    try:
        return int(v)
    except (TypeError, ValueError):
        return 0


def reconcile_sessions(wanted: dict[str, int]) -> dict[str, int]:
    """Make the account's sessions match `wanted` (node_address -> preferred id).

    Returns node_address -> usable active session id. Rules, newest-first:
      * inactive/inactive-pending sessions are cancelled (cleanup);
      * for a wanted node, keep exactly one active session (the preferred id if
        it is still active, else the newest) and cancel the rest;
      * active sessions on nodes we do not want are left alone (not ours to kill)
        unless `prune_others` is set.
    """
    sessions = all_sessions()
    kept: dict[str, int] = {}

    def cancel(sid: int, why: str):
        print(f"  cancel session {sid} ({why})")
        try:
            cancel_session(sid, wait=False)
        except SystemExit:
            print(f"  warning: could not cancel {sid}; it will expire on its own")

    # 1. cleanup: anything already inactive-pending is dead weight
    for s in sessions:
        if not session_active(s.get("status")):
            cancel(s["id"], "stale/inactive")

    # 2. per wanted node, pick the keeper and cancel duplicates
    active = [s for s in sessions if session_active(s.get("status"))]
    for node, preferred in wanted.items():
        here = sorted((s for s in active if s.get("node_address") == node),
                      key=lambda s: s["id"], reverse=True)
        if not here:
            continue
        keeper = None
        for s in here:
            if s["id"] == preferred:
                keeper = s
                break
        if keeper is None:
            keeper = here[0]  # newest
        kept[node] = keeper["id"]
        for s in here:
            if s["id"] != keeper["id"]:
                cancel(s["id"], f"duplicate on {node}")
    return kept


# ---------------------------------------------------------------- systemd

def systemctl(action: str, quiet: bool = False, interactive: bool = True) -> int:
    # sudoers grants passwordless control once install.sh ran.
    unit = unit_name()
    p = subprocess.run(["sudo", "-n", "systemctl", action, unit],
                       capture_output=True, text=True)
    if p.returncode != 0 and interactive:
        # not installed yet, or no sudoers rule: fall back to an interactive prompt
        p = subprocess.run(["sudo", "systemctl", action, unit],
                           capture_output=True, text=True)
    if p.returncode != 0 and not quiet:
        sys.stderr.write(p.stdout + p.stderr)
    return p.returncode


def unit_installed() -> bool:
    p = subprocess.run(["systemctl", "cat", unit_name()],
                       capture_output=True, text=True)
    return p.returncode == 0


def unit_active(name: str | None = None) -> bool:
    p = subprocess.run(["systemctl", "is-active", name or unit_name()],
                       capture_output=True, text=True)
    return p.stdout.strip() == "active"


def iface_exists() -> bool:
    """Kernel view of the interface; `wg show` needs root, sysfs does not."""
    return os.path.exists(f"/sys/class/net/{iface()}")


def wg_show(*args: str) -> str:
    """`wg show` output, or '' if unreadable. Needs root; tries passwordless sudo."""
    base = ["wg", "show", iface(), *args]
    p = subprocess.run(base, capture_output=True, text=True)
    if p.returncode != 0:
        p = subprocess.run(["sudo", "-n", *base], capture_output=True, text=True)
    return p.stdout if p.returncode == 0 else ""


def wait_for_iface(timeout: float = 40.0) -> bool:
    deadline = time.time() + timeout
    while time.time() < deadline:
        if unit_active() and iface_exists():
            return True
        time.sleep(1)
    return False


# ---------------------------------------------------------------- commands

def session_mode_label(cfg: dict) -> str:
    if cfg["session_gigabytes"] > 0:
        return f"{cfg['session_gigabytes']}GB"
    return f"{cfg['session_hours']}h"


def bring_up(node: dict, cfg: dict) -> bool:
    """Start (or reuse) a session for `node`, point the unit at it, bring the
    tunnel up, and wait for the interface. Returns False on any failure."""
    # Check the unit first: without it we would escrow a session only to fail.
    if not unit_installed():
        sys.stderr.write(f"tunnel unit {unit_name()} is not installed - run ./install.sh\n")
        return False
    sid = start_session(cfg, node)
    write_session_file(sid)
    # A previous failed connect can leave the unit in systemd's start-limit-hit
    # state, which refuses further starts for two minutes; clear it first.
    systemctl("reset-failed", quiet=True, interactive=False)
    if systemctl("restart") != 0:
        sys.stderr.write("could not start the tunnel unit\n")
        return False
    if not wait_for_iface():
        sys.stderr.write("tunnel did not come up; recent logs:\n")
        subprocess.run(["journalctl", "-u", unit_name(), "-n", "30", "--no-pager"])
        return False
    return True


def tear_down_iface(cancel: bool = True) -> None:
    """Stop the tunnel and (optionally) cancel the session it was using."""
    sid = read_session_file()
    systemctl("stop", quiet=True)
    if cancel and sid:
        try:
            cancel_session(sid)
        except SystemExit:
            print(f"  warning: could not cancel session {sid}; it will expire")
    if os.path.exists(SESSION_FILE):
        os.remove(SESSION_FILE)


def probe_candidates(cfg: dict, nodes: list[dict]) -> list[dict]:
    """Affordable, non-excluded nodes ranked by advertised downlink, top N."""
    exc = set(excluded_nodes())
    candidates = [n for n in sort_nodes(nodes)
                  if n["address"] not in exc and n.get("gb")
                  and gb_price(n) <= cfg["max_price_per_gb"]]
    if not candidates:
        candidates = [n for n in sort_nodes(nodes) if n["address"] not in exc]
    if not candidates:
        sys.exit("no candidate nodes available")
    return candidates[:max(1, cfg["speed_probe_count"])]


def probe_and_select(cfg: dict, nodes: list[dict], verbose: bool = True) -> tuple[dict, float | None]:
    """Test the top candidates and keep the fastest measured one.

    Each candidate is connected for real (a refundable session is escrowed then
    cancelled for losers). Measured speeds are cached so repeat calls can skip
    known-slow nodes. Falls back to the advertised-best node if nothing measures.
    """
    if not unit_installed():
        node = best_node(cfg, nodes, exclude=set(excluded_nodes()))
        print(f"tunnel unit {unit_name()} is not installed; run ./install.sh")
        return node, None

    top = probe_candidates(cfg, nodes)
    ranked: list[tuple[dict, float]] = []
    for node in top:
        cached = cached_speed(node["address"], cfg["speed_cache_ttl"])
        if cached is not None:
            if verbose:
                print(f"probe {node['moniker']}: cached {cached / 1e6:.1f} MB/s")
            ranked.append((node, cached))
            continue

        print(f"probe {node['moniker']} [{node['country']}] ...")
        if not bring_up(node, cfg):
            print("  could not connect; skipping")
            tear_down_iface(cancel=True)
            continue
        bps = measure_speed(cfg)
        if bps is None:
            print("  speed test failed; skipping")
            tear_down_iface(cancel=True)
            continue
        record_speed(node["address"], bps)
        print(f"  measured {bps / 1e6:.1f} MB/s ({bps * 8 / 1e6:.0f} Mbps)")
        ranked.append((node, bps))
        tear_down_iface(cancel=True)

    if not ranked:
        # nothing connected; fall back to advertised best so `up` still tries
        node = best_node(cfg, nodes, exclude=set(excluded_nodes()))
        print(f"no node could be measured; falling back to {node['moniker']}")
        return node, None

    ranked.sort(key=lambda x: x[1], reverse=True)
    winner, bps = ranked[0]
    if verbose:
        print(f"fastest: {winner['moniker']} at {bps / 1e6:.1f} MB/s")
    return winner, bps


def cmd_up(args):
    cfg = load_cfg()
    if not wallet_exists():
        sys.exit("no wallet yet - run: dvpnctl init")
    nodes = fetch_nodes(refresh=False)

    if args.gigabytes is not None:
        cfg["session_gigabytes"] = args.gigabytes
    if args.hours is not None:
        cfg["session_hours"] = args.hours
        cfg["session_gigabytes"] = 0
    save_cfg(cfg)

    spec = args.node or cfg.get("node") or "best"
    bps = None
    if spec in ("best", "auto") and not args.no_probe:
        node, bps = probe_and_select(cfg, nodes)
    else:
        node = resolve_node(cfg, spec, nodes)

    price_note = (f"{gb_price(node):.3f} DVPN/GB" if node.get("gb")
                  else f"{node['hour']['quote'] / 1e6:.3f} DVPN/h")
    speed_note = f"  {bps / 1e6:.1f} MB/s" if bps else ""
    print(f"endpoint: {node['moniker']} [{node['country']}] {price_note}  "
          f"{node['address']}{speed_note}")

    print("bringing up tunnel ...")
    if not bring_up(node, cfg):
        sys.exit(1)
    print(f"ON  {node['moniker']}  {node['country']}  "
          f"[full tunnel + kill switch, {session_mode_label(cfg)}]")
    cmd_status(args)


def human_bytes(n: int) -> str:
    if n >= 1e9:
        return f"{n / 1e9:.2f} GB"
    if n >= 1e6:
        return f"{n / 1e6:.1f} MB"
    if n >= 1e3:
        return f"{n / 1e3:.1f} KB"
    return f"{n} B"


def session_report(sid: int) -> str | None:
    """One-line bandwidth/cost summary for a session, read from the chain."""
    import yaml
    data = yaml.safe_load(cli(["query", "session", str(sid)], rpc=True)) or {}
    s = data.get("base_session") or {}
    if "download_bytes" not in s:
        s = next((d for d in walk(data) if "download_bytes" in d), {})
    price = data.get("price") or next(
        (d for d in walk(data) if "quote_value" in d), {})
    if "download_bytes" not in s:
        return None

    down = int(s.get("download_bytes") or 0)
    up = int(s.get("upload_bytes") or 0)
    used = down + up
    quote = int(price.get("quote_value") or 0)  # udvpn per GB
    max_bytes = int(s.get("max_bytes") or 0)
    cost = used / 1e9 * quote / 1e6
    escrow = max_bytes / 1e9 * quote / 1e6
    parts = [f"{human_bytes(used)} used ({human_bytes(down)} down, "
             f"{human_bytes(up)} up), cost ~{cost:.4f} DVPN"]
    if escrow:
        parts.append(f"refund ~{escrow - cost:.4f} of {escrow:.4f} DVPN escrowed")
    return f"session {sid}: " + ", ".join(parts)


def cmd_down(args):
    sid = read_session_file()
    rc = systemctl("stop", quiet=True)
    if rc != 0:
        print("warning: could not stop dvpnctl.service (run sudo ./install.sh)", file=sys.stderr)
    if sid:
        try:
            report = session_report(sid)
        except SystemExit:
            report = None
        if report:
            print(report)
    if sid and not args.keep_session:
        print(f"cancelling session {sid} (refunds unused deposit) ...")
        try:
            cancel_session(sid)
        except SystemExit:
            print("session cancel failed; it will expire on its own")
    if os.path.exists(SESSION_FILE):
        os.remove(SESSION_FILE)
    cfg = load_cfg()
    cfg.pop("node_moniker", None)
    save_cfg(cfg)
    print("OFF (kill switch removed with the tunnel)")


